---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../site.config';

const items = (await getCollection('bookmarks')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const pad = (n: number) => String(n).padStart(2, '0');

const host = (u: string) => {
  try {
    return new URL(u).hostname.replace(/^www\./, '');
  } catch {
    return u;
  }
};
---

<Base title={`收藏 · ${SITE.name}`} description="一些用得上、或者只是觉得有意思的东西。">
  <section class="page-head">
    <div class="wrap">
      <div class="page-head-row">
        <span class="mono">Collection</span>
        <span class="mono">{pad(items.length)} 条 / 全部外链</span>
      </div>
      <h1>收藏</h1>
      <p>一些用得上、或者只是觉得有意思的东西。点开就是原站。</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap">
      <div class="lrows">
        {
          items.map((b) => (
            <a class="lrow reveal" href={b.data.url} target="_blank" rel="noopener">
              <span class="lrow-cat">{b.data.category}</span>
              <span>
                <span class="lrow-title">{b.data.title}</span>
                <span class="lrow-desc">{b.data.description}</span>
              </span>
              <span class="lrow-side">{host(b.data.url)}</span>
            </a>
          ))
        }
      </div>

      {items.length === 0 && <p class="empty">还没有收藏。</p>}
    </div>
  </section>
</Base>
