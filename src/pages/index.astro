---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../site.config';

const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featured = works.find((w) => w.data.featured) ?? works[0];
const rest = works.filter((w) => w.id !== featured?.id);

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const bookmarks = (await getCollection('bookmarks'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const host = (u: string) => {
  try {
    return new URL(u).hostname.replace(/^www\./, '');
  } catch {
    return u;
  }
};
---

<Base>
  <section class="hero">
    <div class="wrap">
      <span class="role reveal">{SITE.role}</span>
      <h1 class="reveal">{SITE.headline}<br /><em>{SITE.headlineAccent}</em></h1>
      <p class="lead reveal">{SITE.intro}</p>
      <div class="hero-actions reveal">
        <a class="btn btn-primary" href="/works/">看看作品</a>
        <a class="btn btn-ghost" href="/about/">关于我</a>
      </div>

      {
        works.length > 0 && (
          <div class="hero-tools reveal">
            <span class="hero-tools-label">
              {works.length} 个作品，全部可以下载
            </span>
            <div class="tool-strip">
              {works.map((w) => (
                <a
                  class="tool-tile"
                  href={`/works/${w.id}/`}
                  title={w.data.title}
                  aria-label={w.data.title}
                >
                  {w.data.icon ? (
                    <img src={w.data.icon} alt="" loading="lazy" />
                  ) : (
                    <span>{w.data.title.trim().charAt(0)}</span>
                  )}
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  {
    featured && (
      <section class="spotlight">
        <div class="wrap">
          <div class="spotlight-grid reveal">
            <div class="spotlight-copy">
              <span class="spotlight-eyebrow">
                {featured.data.category}
                {featured.data.badge && ` · ${featured.data.badge}`}
              </span>
              <h2>{featured.data.title}</h2>
              <p class="spotlight-lead">
                {featured.data.summary || featured.data.tagline}
              </p>

              {featured.data.highlights.length > 0 && (
                <ul class="spotlight-points">
                  {featured.data.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}

              <div class="hero-actions reveal">
                {featured.data.download && (
                  <a
                    class="btn btn-primary"
                    href={featured.data.download.url}
                    target="_blank"
                    rel="noopener"
                  >
                    {featured.data.download.label}
                  </a>
                )}
                <a class="btn btn-ghost" href={`/works/${featured.id}/`}>
                  了解更多
                </a>
              </div>
            </div>

            <div class="spotlight-visual">
              {featured.data.icon && (
                <img class="spotlight-mascot" src={featured.data.icon} alt="" />
              )}
              {featured.data.screens.length > 0 && (
                <div class="phone">
                  <img
                    src={featured.data.screens[0]}
                    alt={`${featured.data.title} 界面截图`}
                  />
                </div>
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    rest.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head reveal">
            <div>
              <span class="section-label">MORE WORK</span>
              <h2>更多作品</h2>
            </div>
            <a href="/works/">全部作品 →</a>
          </div>
          <div class="work-grid">
            {rest.map((w) => (
              <WorkCard work={w} reveal />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    bookmarks.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head reveal">
            <div>
              <span class="section-label">COLLECTION</span>
              <h2>收藏</h2>
            </div>
            <a href="/collection/">全部 →</a>
          </div>
          <div class="bookmark-grid">
            {bookmarks.map((b) => (
              <a class="bookmark reveal" href={b.data.url} target="_blank" rel="noopener">
                <div class="cat">{b.data.category}</div>
                <h3 class="name">{b.data.title}</h3>
                <p class="desc">{b.data.description}</p>
                <span class="url">{host(b.data.url)}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="section">
        <div class="wrap wrap-narrow">
          <div class="section-head reveal">
            <div>
              <span class="section-label">NOTES</span>
              <h2>最近写的</h2>
            </div>
            <a href="/blog/">全部 →</a>
          </div>
          <ul class="post-list">
            {posts.map((post) => (
              <li class="post-item reveal">
                <a href={`/blog/${post.id}/`}>
                  <span class="post-date">{fmt(post.data.date)}</span>
                  <span>
                    <span class="post-title">{post.data.title}</span>
                    {post.data.description && (
                      <span class="post-desc">{post.data.description}</span>
                    )}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>
