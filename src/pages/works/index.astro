---
import Base from '../../layouts/Base.astro';
import WorkRow from '../../components/WorkRow.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../site.config';

const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categories = [
  '全部',
  ...Array.from(new Set(works.map((w) => w.data.category))),
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<Base title={`作品 · ${SITE.name}`} description="自己做的工具，全部可以下载。">
  <section class="page-head">
    <div class="wrap">
      <div class="page-head-row">
        <span class="mono">Works</span>
        <span class="mono">{pad(works.length)} 个作品 / 全部免费</span>
      </div>
      <h1>作品</h1>
      <p>自己做的工具，都会放在这里。全部免费，有问题直接找我。</p>

      {
        works.length > 1 && (
          <div class="filters">
            {categories.map((c, i) => (
              <button class={i === 0 ? 'filter is-active' : 'filter'} data-cat={c}>
                {c}
              </button>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap">
      <div class="rows">
        {works.map((w, i) => <WorkRow work={w} index={i + 1} />)}
      </div>

      {works.length === 0 && <p class="empty">还没有作品。</p>}
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const rows = document.querySelectorAll<HTMLElement>('.wrow');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      const cat = btn.dataset.cat;
      rows.forEach((row) => {
        const match = cat === '全部' || row.dataset.cat === cat;
        row.style.display = match ? '' : 'none';
      });
    });
  });
</script>
