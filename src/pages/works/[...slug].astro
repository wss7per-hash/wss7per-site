---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const works = await getCollection('works', ({ data }) => !data.draft);
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content, headings } = await render(work);
const d = work.data;

const all = await getCollection('works', ({ data }) => !data.draft);
const related = all.filter((w) => w.id !== work.id).slice(0, 3);

const pad = (n: number) => String(n).padStart(2, '0');
const fmt = (x: Date) =>
  `${x.getFullYear()}.${pad(x.getMonth() + 1)}.${pad(x.getDate())}`;

const isVideoFile = /\.(mp4|webm|ogg)$/i.test(d.video);
const hasStrip = d.screens.length >= 2;
const guide = d.links.find((l) => /指南|文档|手册|guide|doc/i.test(l.label));

const toc = headings.filter((h) => h.depth === 2).slice(0, 7);

const featureCards = d.features.map((f) => {
  const parts = f.split(/\s*——\s*/);
  return { name: parts[0], desc: parts.slice(1).join(' —— ') };
});
---

<Base
  title={`${d.title} · ${SITE.name}`}
  description={d.summary || d.tagline || d.title}
>
  <section class="work-hero">
    <div class="wrap">
      <a class="back" href="/works/">全部作品</a>

      <div class="dhead">
        <div class="dhead-l">
          <div class="mono" style="margin-top:18px;">
            {d.category}
            {d.platforms.length > 0 && ` · ${d.platforms.join(' / ')}`}
            {d.version && ` · V${d.version}`}
          </div>

          <h1 class="reveal">{d.title}</h1>
          {d.tagline && <p class="tagline reveal">{d.tagline}</p>}
          {d.summary && <p class="summary reveal">{d.summary}</p>}

          <div class="hero-actions reveal">
            {
              d.download && (
                <a
                  class="btn btn-primary"
                  href={d.download.url}
                  target="_blank"
                  rel="noopener"
                >
                  {d.download.label}
                  <svg viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path
                      d="M7 2.5v6M4 6l3 3 3-3M2.5 11.5h9"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="square"
                    />
                  </svg>
                </a>
              )
            }
            {
              guide && (
                <a class="btn btn-ghost" href={guide.url} target="_blank" rel="noopener">
                  {guide.label}
                </a>
              )
            }
          </div>
        </div>

        <aside class="dhead-r reveal">
          <dl class="spec">
            <div><dt>分类</dt><dd>{d.category}</dd></div>
            {d.version && <div><dt>版本</dt><dd>v{d.version}</dd></div>}
            {
              d.platforms.length > 0 && (
                <div><dt>平台</dt><dd>{d.platforms.join(' / ')}</dd></div>
              )
            }
            <div><dt>更新</dt><dd>{fmt(d.date)}</dd></div>
            {d.badge && <div><dt>状态</dt><dd>{d.badge}</dd></div>}
          </dl>
        </aside>
      </div>
    </div>
  </section>

  {
    d.video && (
      <div class="wrap">
        <div class="video-wrap reveal-media">
          {isVideoFile ? (
            <video src={d.video} controls playsinline poster={d.cover || undefined} />
          ) : (
            <iframe
              src={d.video}
              title={d.title}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture"
              allowfullscreen
              loading="lazy"
            />
          )}
        </div>
      </div>
    )
  }

  {
    !d.video && hasStrip && (
      <div class="wrap">
        <div class="strip">
          {d.screens.slice(0, 3).map((src, i) => (
            <div class="cell reveal-media">
              <div class="cell-shot">
                <img src={src} alt={`${d.title} 界面截图 ${i + 1}`} loading="lazy" />
              </div>
              <div class="cell-cap">
                <span class="mono">界面预览</span>
                <span class="mono">{pad(i + 1)}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    )
  }

  {
    !d.video && !hasStrip && d.cover && (
      <div class="wrap">
        <a class="work-cover reveal-media" href={d.download?.url ?? '#'} target="_blank" rel="noopener">
          <img src={d.cover} alt={d.title} />
        </a>
      </div>
    )
  }

  {
    d.stats.length > 0 && (
      <section class="section" style="padding-bottom:0;">
        <div class="wrap">
          <div class="stat-row reveal">
            {d.stats.map((s) => (
              <div class="stat">
                <div class="stat-value">{s.value}</div>
                <div class="stat-label">{s.label}</div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    featureCards.length > 0 && (
      <section class="section" style="padding-bottom:0;">
        <div class="wrap">
          <h2 class="block-title">主要功能</h2>
          <div class="feature-grid reveal">
            {featureCards.map((f, i) => (
              <div class="feature-card">
                <span class="feature-idx">{pad(i + 1)}</span>
                <h3 class="feature-name">{f.name}</h3>
                {f.desc && <p class="feature-desc">{f.desc}</p>}
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <div class="doc-grid">
        <div>
          <span class="section-label">说明</span>
          {
            toc.length > 1 && (
              <nav class="toc-chips" aria-label="本页内容" style="margin-top:18px;">
                {toc.map((h) => (
                  <a href={`#${h.slug}`}>{h.text}</a>
                ))}
              </nav>
            )
          }
        </div>

        <div>
          <div class="prose reveal">
            <Content />
          </div>

          {
            d.gallery.length > 0 && (
              <div class="gallery">
                {d.gallery.map((src) => (
                  <img src={src} alt="" loading="lazy" />
                ))}
              </div>
            )
          }
        </div>
      </div>

      {
        d.links.length > 0 && (
          <div class="link-row">
            {d.links.map((l) => (
              <a class="btn btn-ghost" href={l.url} target="_blank" rel="noopener">
                {l.label}
                <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path
                    d="M3 9L9 3M9 3H4.5M9 3V7.5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="square"
                  />
                </svg>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section" style="padding-top:0;">
        <div class="wrap">
          <div class="section-head reveal-rule reveal">
            <div>
              <span class="section-label">More</span>
              <h2 style="margin-top:10px;">其他作品</h2>
            </div>
            <a class="more" href="/works/">全部 →</a>
          </div>

          <div class="work-grid" style="margin-top:26px;">
            {related.map((w) => (
              <div class="work-item">
                <WorkCard work={w} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
