---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const works = await getCollection('works', ({ data }) => !data.draft);
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content, headings } = await render(work);
const d = work.data;

const all = await getCollection('works', ({ data }) => !data.draft);
const related = all.filter((w) => w.id !== work.id).slice(0, 3);

const fmt = (x: Date) =>
  `${x.getFullYear()}.${String(x.getMonth() + 1).padStart(2, '0')}.${String(x.getDate()).padStart(2, '0')}`;

const isVideoFile = /\.(mp4|webm|ogg)$/i.test(d.video);
const hasScreens = d.screens.length > 0;
const guide = d.links.find((l) => /指南|文档|手册|guide|doc/i.test(l.label));

const toc = headings.filter((h) => h.depth === 2).slice(0, 7);

const featureCards = d.features.map((f) => {
  const parts = f.split(/\s*——\s*/);
  return { name: parts[0], desc: parts.slice(1).join(' —— ') };
});
---

<Base
  title={`${d.title} · ${SITE.name}`}
  description={d.summary || d.tagline || d.title}
>
  <section
    class="work-hero"
    style={d.accent ? `--accent-local:${d.accent}` : undefined}
  >
    <div class="wrap wrap-narrow">
      <a class="back" href="/works/">← 全部作品</a>

      <div class="work-head reveal">
        {d.icon && <img class="work-icon" src={d.icon} alt="" />}
        <div>
          <h1>{d.title}</h1>
          {d.tagline && <p class="tagline">{d.tagline}</p>}
        </div>
      </div>

      {d.summary && <p class="work-summary reveal">{d.summary}</p>}

      <div class="meta-row reveal">
        <span class="meta-item">分类 <b>{d.category}</b></span>
        {d.version && <span class="meta-item">版本 <b>v{d.version}</b></span>}
        {
          d.platforms.length > 0 && (
            <span class="meta-item">平台 <b>{d.platforms.join(' / ')}</b></span>
          )
        }
        <span class="meta-item">更新 <b>{fmt(d.date)}</b></span>
      </div>

      <div class="hero-actions reveal">
        {
          d.download && (
            <a
              class="btn btn-primary"
              href={d.download.url}
              target="_blank"
              rel="noopener"
            >
              {d.download.label}
            </a>
          )
        }
        {
          guide && (
            <a class="btn btn-ghost" href={guide.url} target="_blank" rel="noopener">
              {guide.label}
            </a>
          )
        }
      </div>
    </div>
  </section>

  {
    d.video && (
      <section style="margin-top:48px;">
        <div class="wrap">
          <div class="video-wrap">
            {isVideoFile ? (
              <video src={d.video} controls playsinline poster={d.cover || undefined} />
            ) : (
              <iframe
                src={d.video}
                title={d.title}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture"
                allowfullscreen
                loading="lazy"
              />
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    !d.video && hasScreens && (
      <section class="phone-section">
        <div class="wrap">
          <div class="phone-row reveal">
            {d.screens.map((src) => (
              <div class="phone">
                <img src={src} alt={`${d.title} 界面截图`} loading="lazy" />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    !d.video && !hasScreens && d.cover && (
      <section class="cover-section">
        <div class="wrap">
          <div class="work-cover">
            <img src={d.cover} alt={d.title} />
          </div>
        </div>
      </section>
    )
  }

  <section class="section" style="padding-top:8px;">
    <div class="wrap wrap-narrow">
      {
        d.stats.length > 0 && (
          <div class="stat-row reveal">
            {d.stats.map((s) => (
              <div class="stat">
                <div class="stat-value">{s.value}</div>
                <div class="stat-label">{s.label}</div>
              </div>
            ))}
          </div>
        )
      }

      {
        d.download && (
          <div class="download-box reveal">
            <div>
              <div class="label">下载</div>
              <h3 class="title">{d.download.label}</h3>
              {d.download.note && <p class="note">{d.download.note}</p>}
            </div>
            <a
              class="btn btn-primary"
              href={d.download.url}
              target="_blank"
              rel="noopener"
            >
              立即下载
            </a>
          </div>
        )
      }

      {
        featureCards.length > 0 && (
          <>
            <h2 class="block-title" style="margin-top:0;">
              主要功能
            </h2>
            <div class="feature-grid reveal">
              {featureCards.map((f, i) => (
                <div class="feature-card">
                  <span class="feature-idx">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="feature-name">{f.name}</h3>
                  {f.desc && <p class="feature-desc">{f.desc}</p>}
                </div>
              ))}
            </div>
          </>
        )
      }

      {
        toc.length > 1 && (
          <nav class="toc-chips reveal" aria-label="本页内容">
            <span class="toc-label">本页</span>
            {toc.map((h) => (
              <a href={`#${h.slug}`}>{h.text}</a>
            ))}
          </nav>
        )
      }

      <div class="prose reveal">
        <Content />
      </div>

      {
        d.gallery.length > 0 && (
          <div class="gallery" style="margin-top:44px;">
            {d.gallery.map((src) => (
              <img src={src} alt="" loading="lazy" />
            ))}
          </div>
        )
      }

      {
        d.links.length > 0 && (
          <div class="link-row reveal">
            {d.links.map((l) => (
              <a class="btn btn-ghost" href={l.url} target="_blank" rel="noopener">
                {l.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head reveal">
            <h2>其他作品</h2>
            <a href="/works/">全部 →</a>
          </div>
          <div class="work-grid">
            {related.map((w) => (
              <WorkCard work={w} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
