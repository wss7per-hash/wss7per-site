---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.intro } = Astro.props;
const year = new Date().getFullYear();
const path = Astro.url.pathname;

const isActive = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));

const navItems = [
  { href: '/works/', label: '作品' },
  { href: '/collection/', label: '收藏' },
  { href: '/blog/', label: '文章' },
  { href: '/about/', label: '关于' },
];

const github = SITE.social.find((s) => /github/i.test(s.label));
const mail = SITE.social.find((s) => s.url.startsWith('mailto:'));

const works = await getCollection('works', ({ data }) => !data.draft);
const count = String(works.length).padStart(2, '0');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/inter-tight-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <div class="topbar">
      <div class="wrap topbar-inner">
        <span class="mono">Independent Software — {SITE.name}</span>
        <span class="mono">{count} Works / Free Download</span>
      </div>
    </div>

    <header class="site-header" id="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand">{SITE.name}</a>

        <nav class="nav" aria-label="主导航">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          {
            github && (
              <>
                <span class="nav-sep" aria-hidden="true" />
                <a
                  class="nav-ext"
                  href={github.url}
                  target="_blank"
                  rel="noopener"
                >
                  GitHub
                  <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path
                      d="M3 9L9 3M9 3H4.5M9 3V7.5"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="square"
                    />
                  </svg>
                </a>
              </>
            )
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-cta">
          <div>
            <span class="mono">Contact</span>
            <h2>有想法，或者遇到了问题？</h2>
          </div>
          {
            mail && (
              <a class="footer-mail" href={mail.url}>
                {mail.url.replace('mailto:', '')}
                <svg width="13" height="13" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path
                    d="M3 9L9 3M9 3H4.5M9 3V7.5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="square"
                  />
                </svg>
              </a>
            )
          }
        </div>

        <div class="footer-bottom">
          <p>© {year} {SITE.name}{SITE.icp ? ` · ${SITE.icp}` : ''}</p>
          <div class="footer-links">
            {
              SITE.social.map((s) => (
                <a href={s.url} target="_blank" rel="noopener">
                  {s.label}
                </a>
              ))
            }
            <a href="/admin/">管理后台</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* 顶栏：滚动后出现下边线 */
      const header = document.getElementById('site-header');
      const onScroll = () => {
        header?.classList.toggle('is-stuck', window.scrollY > 8);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      /* 滚动进场：同级元素依次错开 */
      const SEL = '.reveal, .reveal-media, .reveal-rule';
      const els = Array.from(document.querySelectorAll<HTMLElement>(SEL));

      els.forEach((el) => {
        const siblings = Array.from(el.parentElement?.children ?? []).filter((c) =>
          c.matches(SEL)
        );
        const i = siblings.indexOf(el);
        if (i > 0) el.style.transitionDelay = `${Math.min(i, 4) * 90}ms`;
      });

      if (!('IntersectionObserver' in window) || reduce) {
        els.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          // threshold 0：.reveal-media 初始被 clip-path 完全裁掉，
          // 可视面积恒为 0，用非零阈值会永远不触发
          { rootMargin: '0px 0px -8% 0px', threshold: 0 }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
