---
import type { CollectionEntry } from 'astro:content';

interface Props {
  work: CollectionEntry<'works'>;
  reveal?: boolean;
}

const { work, reveal = false } = Astro.props;
const { title, tagline, category, cover, version, screens, icon, badge } =
  work.data;

const hasScreens = screens.length > 0;
const hasIcon = Boolean(icon);
const meta = [version && `v${version}`].filter(Boolean).join('');
---

<a
  class={reveal ? 'work-card reveal' : 'work-card'}
  href={`/works/${work.id}/`}
>
  <div
    class="work-media"
    data-shot={hasScreens ? 'app' : undefined}
    data-icon={!hasScreens && !cover && hasIcon ? 'true' : undefined}
  >
    {
      hasScreens ? (
        <div class="screens-strip">
          {screens.slice(0, 3).map((src) => (
            <img src={src} alt="" loading="lazy" />
          ))}
        </div>
      ) : cover ? (
        <img src={cover} alt={title} loading="lazy" />
      ) : hasIcon ? (
        <img class="icon-tile" src={icon} alt={title} loading="lazy" />
      ) : (
        <div class="placeholder">
          <span>{title.trim().charAt(0)}</span>
        </div>
      )
    }
    {badge && <span class="work-badge">{badge}</span>}
  </div>

  <div class="work-body">
    <div class="work-cat">
      {category}
      {meta && <span class="work-cat-sep"> / {meta}</span>}
    </div>
    <h3 class="work-title">{title}</h3>
    {tagline && <p class="work-tagline">{tagline}</p>}
  </div>
</a>
